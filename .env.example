# ---------- 驰声 MCP 评测 ----------
CHIVOX_API_KEY="******"
CHIVOX_MCP_URL="https://mcp.cloud.chivox.com"
# 发音类型：1 英式 / 2 美式 / 3 不区分
CHIVOX_ACCENT=3
# 评分制：100 或 4
CHIVOX_RANK=100

# ---------- 大模型（deepseek / OpenAI 兼容） ----------
LLM_API_KEY="******"
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-flash"

# ---------- 驰声MCP请求耗时 ----------
CHIVOX_TIMEOUT=120

